{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{js,cjs,mjs}"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts"],
      // Generated by `pnpm db:types` with helpers the app may never use (#215).
      "ignore": ["src/backend/database.gen.ts"],
    },
    "packages/art": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"],
    },
    "packages/config": {
      "entry": [],
      "project": [],
    },
    "packages/engine": {
      "project": ["src/**/*.ts"],
    },
    "packages/game": {
      "project": ["src/**/*.ts"],
    },
    "packages/server": {
      "project": ["src/**/*.ts"],
    },
    "packages/ui": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx,mdx}", "scripts/*.ts"],
    },
  },
}
