{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.{js,cjs,mjs}"],
    },
    "apps/web": {
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/config": {
      "entry": [],
      "project": [],
    },
    "packages/engine": {
      "project": ["src/**/*.ts"],
    },
    "packages/game": {
      "project": ["src/**/*.ts"],
    },
    "packages/ui": {
      "entry": ["scripts/*.ts"],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.ts"],
    },
  },
}
