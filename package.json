{
  "name": "buzzkill",
  "version": "1.0.0",
  "private": true,
  "description": "Buzzkill — a side-scrolling Canvas shooter in TypeScript. Defend the city from an alien insect swarm, day and night.",
  "license": "MIT",
  "author": "Nazima Jumaniyazova",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@buzzkill/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0 && stylelint \"**/*.css\" && pnpm lint:repo",
    "lint:fix": "eslint . --fix && stylelint \"**/*.css\" --fix",
    "lint:repo": "sherif && knip && depcruise apps packages && cspell --no-progress --dot --gitignore \"**/*.{ts,tsx,js,cjs,mjs,md,yml,yaml}\"",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "cspell": "^10.4.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-testing-library": "catalog:",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.3",
    "sherif": "^1.13.0",
    "stylelint": "^17.16.0",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.0",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  }
}
