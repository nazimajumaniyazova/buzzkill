{
  "name": "@buzzkill/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Buzzkill design system: tokens, themes and accessible React components. Knows nothing about the game.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "scripts": {
    "build": "storybook build",
    "storybook": "storybook dev --port 6006 --no-open",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "typecheck": "cmk && tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@buzzkill/config": "workspace:*",
    "@css-modules-kit/codegen": "catalog:",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "jsdom": "catalog:",
    "playwright": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-axe": "catalog:"
  }
}
