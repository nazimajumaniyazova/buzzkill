{
  "name": "@buzzkill/game",
  "version": "0.0.0",
  "private": true,
  "description": "Buzzkill game domain: entities, systems, rules and levels as data. Depends only on the engine; no DOM, no React.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./legacy": "./src/legacy/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/legacy/tsconfig.json"
  },
  "dependencies": {
    "@buzzkill/engine": "workspace:*"
  },
  "devDependencies": {
    "@buzzkill/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
