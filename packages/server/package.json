{
  "name": "@buzzkill/server",
  "version": "0.0.0",
  "private": true,
  "description": "Buzzkill backend logic: verifies a submitted run by playing its replay again with the game. No DOM; the Supabase Edge Function bundles it.",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "bundle": "tsx scripts/bundle.ts",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p function/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json"
  },
  "dependencies": {
    "@buzzkill/game": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@buzzkill/config": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
